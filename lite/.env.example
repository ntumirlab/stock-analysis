# GoldenAI Lite 環境變數範本：複製為 .env 後填寫
# 「實驗室提供」的值請向實驗室索取；其餘由使用者自備

# docker compose 使用的 image 版本（與 docker load 進來的 tar 版本一致）
GOLDENAI_LITE_TAG=v1.0.0

# FinLab API（實驗室提供）
FINLAB_API_TOKEN=

# 推薦清單 Google Drive 發布資料夾（實驗室提供）
WEEKLY_FETCH_FOLDER_ID=

# Google Drive OAuth token 檔路徑（檔案放進 ./credentials/，取得方式由實驗室協助）
GOOGLE_TOKEN_PATH=./credentials/google_token.json

# Telegram 通知（@BotFather 建立 bot 取得 token；chat_id 為接收通知的群組/個人）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# Shioaji (永豐金證券) 憑證（使用者自備，申請方式見 README）
# ============================================================================
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CERT_PERSON_ID=
SHIOAJI_CERT_PATH=./credentials/Sinopac.pfx
SHIOAJI_CERT_PASSWORD=
