# Crontab for stock-analysis scheduler
# 格式: 分 時 日 月 週 指令

# cron 啟動的 job 拿不到 docker-compose 的 TZ 環境變數（cron 給 job 乾淨環境），
# 沒有這行的話 job 內的 log 時間戳會顯示 UTC。排程時間不受此行影響（daemon 已是台北時區）。
TZ=Asia/Taipei

# 每天 20:30 - 抓取當日持股和帳戶資訊
30 20 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.scheduler --user_name=kiri --broker_name=shioaji >> /app/logs/fetch.log 2>&1

# 每天 21:55 - 執行回測（Alan 七模型 + PeterWu；首支保留 10 分鐘給當日資料下載，其後每 3 分鐘一支）
55 21 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFGSimple >> /app/logs/backtest.log 2>&1
5 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFG95Simple >> /app/logs/backtest.log 2>&1
8 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFG95Full >> /app/logs/backtest.log 2>&1
11 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyACESimple >> /app/logs/backtest.log 2>&1
14 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFGNotStart >> /app/logs/backtest.log 2>&1
17 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFG95ACEFull >> /app/logs/backtest.log 2>&1
20 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=AlanTWStrategyEFG95ACESimple >> /app/logs/backtest.log 2>&1
23 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=PeterWuStrategy >> /app/logs/backtest.log 2>&1

25 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=OscarCompositeStrategy >> /app/logs/backtest.log 2>&1
35 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=GoldenAITWStrategyWeekly >> /app/logs/backtest.log 2>&1
45 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=GoldenAITWStrategyWeekly4W >> /app/logs/backtest.log 2>&1
55 22 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.backtest_executor --strategy_class_name=GoldenAITWStrategyMonthly >> /app/logs/backtest.log 2>&1

# 每天 23:10 - 計算單期清單（節點）：只算最近 14 天內結算的，已存在的跳過。
10 23 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.golden_ai_node_executor --strategy weekly --days 14 --all-ranks >> /app/logs/nodes.log 2>&1
20 23 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.golden_ai_node_executor --strategy weekly_4w --days 14 --all-ranks >> /app/logs/nodes.log 2>&1
30 23 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.golden_ai_node_executor --strategy monthly --days 14 --all-ranks >> /app/logs/nodes.log 2>&1

# 每天 07:30 - 發布解析後的推薦清單 JSON 到 Drive（只補 Drive 缺的日期）
30 7 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.recommendations_publisher >> /app/logs/recommendations_publisher.log 2>&1

# 每天 08:10 - 下單
10 8 * * * cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.order_executor --user_name=kiri --broker_name=shioaji >> /app/logs/order.log 2>&1

# 每週日 23:45 - 抓取新推薦名單.md
45 23 * * 7 cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.drive_fetcher >> /app/logs/drive_fetcher.log 2>&1

# 每週日 23:50 - 解析推薦名單 (weekly & monthly)
50 23 * * 7 cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.recommendations_parser --task=weekly >> /app/logs/recommendations_parser.log 2>&1
55 23 * * 7 cd /app && /opt/conda/envs/stock-analysis/bin/python -m jobs.recommendations_parser --task=monthly >> /app/logs/recommendations_parser.log 2>&1

# 空行必須保留 (cron 要求)
